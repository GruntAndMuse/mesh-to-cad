def find_bundled_file(name: str) -> Path | None:
    """Locate a file bundled with the CLI (CHANGELOG.md, etc.).

    Works both from source (file sits next to this script) and frozen
    (PyInstaller extracts datas into sys._MEIPASS, which CLI_DIR already
    points at). Returns None if not found.
    """
    candidate = CLI_DIR / name
    return candidate if candidate.is_file() else None


def cmd_changelog() -> None:
    """Print the bundled CHANGELOG.md. Fully offline — no network."""
    path = find_bundled_file("CHANGELOG.md")
    if path is None:
        die(
            "changelog not found.",
            "CHANGELOG.md should ship next to mesh-to-cad (or bundled in "
            "the exe). If you built from source, make sure it's in the "
            "mesh-to-cad folder.",
        )
    print(path.read_text(encoding="utf-8").rstrip())
    print()


# ---------------------------------------------------------------------------
# Subcommand: update (manual check only — never automatic)
# ---------------------------------------------------------------------------
UPDATE_API_URL = "https://api.github.com/repos/GruntAndMuse/mesh-to-cad/releases/latest"
UPDATE_API_LIST_URL = "https://api.github.com/repos/GruntAndMuse/mesh-to-cad/releases?per_page=5"
# Test hook: MESH_TO_CAD_UPDATE_URL env var overrides the API URL, so the
# offline/error path can be exercised without blocking the network.
# Not documented in --help; for testing only.
def _update_url() -> str:
    return os.environ.get("MESH_TO_CAD_UPDATE_URL") or UPDATE_API_URL


def _update_list_url() -> str:
    return os.environ.get("MESH_TO_CAD_UPDATE_URL") or UPDATE_API_LIST_URL


def _ver_tuple(v: str) -> tuple:
    """'1.0.1' -> (1, 0, 1). Non-numeric parts sort after numbers."""
    parts = []
    for p in v.lstrip("v").split("."):
        parts.append(int(p) if p.isdigit() else p)
    return tuple(parts)


def _fetch_json(url: str, timeout: int = 15) -> dict | list:
    """GET JSON. Raises RuntimeError with a friendly message on any failure
    (no network, DNS, timeout, bad response) — never a traceback."""
    import urllib.request
    import urllib.error
    req = urllib.request.Request(url, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": f"mesh-to-cad/{VERSION}",
    })
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"GitHub API returned HTTP {e.code}") from e
    except urllib.error.URLError as e:
        raise RuntimeError(
            "couldn't reach github.com — check your internet connection."
        ) from e
    except TimeoutError as e:
        raise RuntimeError(
            "GitHub didn't answer in time — try again later."
        ) from e
    except (ValueError, KeyError) as e:
        raise RuntimeError(
            f"GitHub gave an unexpected response ({e}) — try again later."
        ) from e


def cmd_update() -> None:
    """Check for a newer release. MANUAL ONLY — this runs solely when the
    user types 'mesh-to-cad update'. Nothing phones home otherwise."""
    url = _update_url()
    try:
        latest = _fetch_json(url)
    except RuntimeError as e:
        die(f"update check failed: {e}",
            "This needs internet. Your installed copy works fine offline — "
            "this check is only for finding out about new versions.")
    if not isinstance(latest, dict) or "tag_name" not in latest:
        die("update check failed: unexpected response from GitHub.",
            "Try again later, or check "
            "https://github.com/GruntAndMuse/mesh-to-cad/releases manually.")

    latest_ver = latest["tag_name"].lstrip("v")
    print(f"  installed: mesh-to-cad {VERSION}")
    print(f"  latest:    {latest['tag_name']}")

    cmp = (_ver_tuple(VERSION) > _ver_tuple(latest_ver)) - \
          (_ver_tuple(VERSION) < _ver_tuple(latest_ver))
    if cmp >= 0:
        if cmp > 0:
            print()
            print("  You are running a newer version than the latest release.")
            print("  (This is a development build — nothing to do.)")
        else:
            print()
            print("  You're up to date. ✓")
        return

    # An update IS available.
    print()
    print(f"  Update available: {VERSION} -> {latest_ver}")
    print()
    body = (latest.get("body") or "").strip()
    if body:
        print("  What's new:")
        for line in body.splitlines()[:40]:
            print(f"    {line}")
        print()
    print(f"  Download: {latest.get('html_url', '')}")
    assets = latest.get("assets") or []
    if assets:
        print("  Files:")
        for a in assets:
            print(f"    {a.get('name')} — {a.get('browser_download_url')}")

    # Revert path: previous release's URL, so "go back" is one download.
    # WHY HERE: no auto-updater means no auto-rollback either. The cheapest
    # revert for a CLI is telling the user exactly where the old version is.
    try:
        releases = _fetch_json(_update_list_url())
        if isinstance(releases, list) and len(releases) > 1:
            prev = releases[1]
            ptag = prev.get("tag_name", "")
            purl = prev.get("html_url", "")
            if ptag and purl:
                print()
                print(f"  To revert, download {ptag} from {purl}")
    except RuntimeError:
        pass  # revert hint is a nicety; the update info above is the point.


# ---------------------------------------------------------------------------
# Full pipeline: intake -> quality gate -> analysis
# ---------------------------------------------------------------------------
def cmd_full(mesh_path: Path, project_dir: Path | None = None,
             as_json: bool = False) -> None:
    """Run the complete Phase 1 pipeline on one file.

    WHY THIS ORDER: units first (a 1000x error corrupts everything after it),
    then quality (no point measuring a mesh that's missing half its surface),
    then analysis (the numbers everything downstream is judged against).
    Each step can stop the pipeline — that's the point. A pipeline that
    can't say "stop" isn't a pipeline, it's a hope.
    """
    # --- Project setup ---
    # WHY A PROJECT FOLDER: the pipeline's SOP tracks input/work/analysis/
    # per project. Dumping outputs next to the input works for one file but
    # collapses the moment you process two versions. Default: a folder named
    # after the file, next to the file. Override with --output.
    if project_dir is None:
        project_dir = mesh_path.parent / mesh_path.stem
    # Track this BEFORE mkdir: if the pipeline dies before completing, we
    # remove the half-built folder — but only if we created it. Never nuke
    # a pre-existing folder on a re-run.
    we_created_project = not project_dir.exists()
    input_dir = project_dir / "input"
    analysis_dir = project_dir / "analysis"
    input_dir.mkdir(parents=True, exist_ok=True)
    analysis_dir.mkdir(parents=True, exist_ok=True)

    # Copy the original into input/. WHY A COPY: the SOP's first rule is
    # "never modify the original." If the input file IS already in input/
    # (re-run), skip the copy — copying a file onto itself is a no-op but
    # the message would confuse.
    input_copy = input_dir / mesh_path.name
    if mesh_path.resolve() != input_copy.resolve():
        shutil.copy2(mesh_path, input_copy)
        print(f"  copied original -> {input_copy}")
    else:
        print(f"  input already in project: {input_copy}")
    working_file = input_copy

    manifest = {
        "project": project_dir.name,
        "tool": f"mesh-to-cad {VERSION}",
        "date": str(date.today()),
        "source": {
            "original_file": str(input_copy),
            "units": "mm (pending confirmation)",
        },
    }

    # --- Pipeline steps ---
    # WHY THE TRY: die() exits via SystemExit from deep inside a
    # step (e.g. unreadable mesh in Step 1). By then we've already
    # created project/input/ and copied the file. Without cleanup
    # the user is left with a half-built folder and no manifest.
    # Exit 2 (needs-rescan) is the exception: it intentionally
    # saves the manifest, so that folder stays.
    try:
        # --- Step 1: Units ---
        step_header(1, 3, "Checking units")
        units = cmd_units(working_file, as_json=False)
        manifest["source"]["units_check"] = {
            "suggestion": units["suggestion"],
            "scale_factor": units["scale_factor"],
            "confidence": units["confidence"],
        }
        if units["suggestion"] == "millimeters":
            step_ok("units look like millimeters — proceeding")
        else:
            # WHY STOP AND ASK: a wrong scale factor silently corrupts every
            # downstream number. The script suggests; the human confirms. This
            # is the one place in Phase 1 where the pipeline refuses to guess.
            print()
            print("  ⚠ Units need your confirmation before continuing.")
            print(f"  Suggestion: {units['suggestion']} (×{units['scale_factor']})")
            print(f"  {units['why']}")
            print()
            answer = input("  Is this correct? [y/N] ").strip().lower()
            if answer not in ("y", "yes"):
                print("\n  Stopped. No files were modified.")
                print("  If you know the correct units, convert the file first")
                print("  (MeshLab: Filters > Normals, Curvatures > Transform: Scale),")
                print("  then run mesh-to-cad again.")
                sys.exit(1)
            step_ok("units confirmed by user")
            manifest["source"]["units"] = f"mm (confirmed, scale ×{units['scale_factor']})"

        # --- Step 2: Quality gate ---
        step_header(2, 3, "Quality gate")
        gate = cmd_check(working_file, as_json=False)
        manifest["quality"] = gate["verdict"]
        manifest["quality_reasons"] = gate["reasons"]
        if gate["verdict"] == "needs-rescan":
            # Exit 2, not 1: SOP scripts can distinguish "pipeline stopped on
            # purpose" (2) from "something broke" (1). The message above already
            # told the user why — this just makes it machine-readable.
            print("\n  The pipeline stopped here ON PURPOSE.")
            print("  No pipeline fixes missing data — rescan the part, then")
            print("  run mesh-to-cad on the new scan.")
            manifest_path = project_dir / "manifest.json"
            manifest_path.write_text(json.dumps(manifest, indent=2), encoding="utf-8")
            print(f"\n  Manifest saved: {manifest_path}")
            sys.exit(2)
        step_ok(f"verdict: {gate['verdict']}")

        # --- Step 3: Analysis ---
        step_header(3, 3, "Analyzing geometry")
        analysis = cmd_analyze(working_file, out_dir=analysis_dir, as_json=False,
            force=True)
        manifest["track"] = analysis["track_decision"]
        manifest["track_confidence"] = analysis["track_confidence"]
        manifest["track_reason"] = analysis["track_reason"]
        step_ok("measurements recorded")

        # --- Manifest ---
        manifest["tools"] = {
            "mesh-to-cad": VERSION,
            # Record what we can; trimesh version is the load-bearing one.
            "python": f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}",
        }
        try:
            import trimesh as _tm
            manifest["tools"]["trimesh"] = _tm.__version__
        except Exception:
            pass
        manifest_path = project_dir / "manifest.json"
        manifest_path.write_text(json.dumps(manifest, indent=2), encoding="utf-8")

        # --- Done: summary + next steps ---
        print(f"\n{'='*60}")
        print("  Pipeline complete ✓")
        print(f"{'='*60}")
        print(f"\n  Project folder: {project_dir}")
        print(f"  Track: {analysis['track_decision']} "
              f"(confidence: {analysis['track_confidence']})")
        print(f"\n  What was created:")
        print(f"    input/{mesh_path.name}         — your original (untouched)")
        print(f"    analysis/*_measurements.json  — every number the CAD must match")
        print(f"    analysis/*_aligned.stl         — mesh in canonical orientation")
        print(f"    manifest.json                 — project record")
        print(f"\n  What to do next:")
        if analysis["track_decision"] == "prismatic":
            print("    1. Open the mesh in FreeCAD as a reference (File > Import).")
            print("    2. Build the part in Part Design, measuring from the mesh.")
            print("       (Tip: MeshToFeatures workbench can automate clean meshes.)")
            print("    3. When the model is done, verify against the ORIGINAL:")
        elif analysis["track_decision"] == "organic":
            print("    1. Open the mesh in FreeCAD (Curves workbench).")
            print("    2. Build the surface, then check it with:")
            print(f"       mesh-to-cad deviation your_model.stl {input_copy}")
            print("    3. When the model is done, verify against the ORIGINAL:")
        else:
            print("    1. This part has both prismatic and organic features.")
            print("    2. Model the prismatic base first, then the organic details.")
            print("    3. Check each stage with:")
            print(f"       mesh-to-cad deviation your_model.stl {input_copy}")
            print("    4. When the model is done, verify against the ORIGINAL:")
        print(f"       mesh-to-cad deviation final_model.stl {input_copy} --tolerance 0.3")
        print(f"\n  Full guide: QUICKSTART.md")
    except SystemExit as _e:
        if _e.code != 2 and we_created_project and project_dir.exists():
            shutil.rmtree(project_dir, ignore_errors=True)
            print(f"  (removed incomplete project folder: {project_dir})",
                  file=sys.stderr)
        raise



