# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
def main() -> None:
    argv = sys.argv[1:]

    # --help / -h anywhere: show help and exit 0. Checked first so --help
    # never falls through to "file not found: --help".
    if not argv or "--help" in argv or "-h" in argv:
        # 'mesh-to-cad check --help' -> subcommand help; bare --help -> full.
        subs = [a for a in argv if a in ("units", "check", "analyze",
                                        "deviation", "update", "changelog")]
        if subs and ("--help" in argv or "-h" in argv):
            print_subcommand_help(subs[0])
        else:
            print_help()
        sys.exit(0)

    # --version: print version and exit 0. Checked early so --version
    # never falls through to "file not found: --version".
    if "--version" in argv:
        print(f"mesh-to-cad {VERSION}")
        sys.exit(0)

    # Pull out global flags before dispatch.
    as_json = "--json" in argv
    argv = [a for a in argv if a != "--json"]
    output_dir = None
    if "--output" in argv:
        idx = argv.index("--output")
        if idx + 1 >= len(argv):
            die("--output needs a directory.", "Example: mesh-to-cad file.stl --output ./myproject")
        output_dir = Path(argv[idx + 1])
        argv = argv[:idx] + argv[idx + 2 :]
    tolerance = None
    if "--tolerance" in argv:
        idx = argv.index("--tolerance")
        if idx + 1 >= len(argv):
            die("--tolerance needs a number in mm.", "Example: --tolerance 0.2")
        try:
            tolerance = float(argv[idx + 1])
        except ValueError:
            die(f"--tolerance needs a number, got '{argv[idx + 1]}'.",
                "Example: --tolerance 0.2  (that's 0.2 millimeters)")
        argv = argv[:idx] + argv[idx + 2 :]

    # Dispatch: first arg is the subcommand, unless it looks like a file.
    first = argv[0]
    if first in ("units", "check", "analyze", "deviation", "update", "changelog"):
        sub, rest = first, argv[1:]
        if sub == "units":
            if len(rest) != 1:
                print_subcommand_help("units")
                sys.exit(1)
            cmd_units(check_file(rest[0]), as_json=as_json)
        elif sub == "check":
            if len(rest) != 1:
                print_subcommand_help("check")
                sys.exit(1)
            result = cmd_check(check_file(rest[0]), as_json=as_json)
            sys.exit(2 if result["verdict"] == "needs-rescan" else 0)
        elif sub == "analyze":
            if len(rest) != 1:
                print_subcommand_help("analyze")
                sys.exit(1)
            cmd_analyze(check_file(rest[0]), out_dir=output_dir,
                        as_json=as_json)
        elif sub == "deviation":
            if len(rest) != 2:
                print_subcommand_help("deviation")
                sys.exit(1)
            cmd_deviation(check_file(rest[0]), check_file(rest[1]),
                          tolerance=tolerance, as_json=as_json)
        elif sub == "update":
            if rest:
                print_subcommand_help("update")
                sys.exit(1)
            cmd_update()
        elif sub == "changelog":
            if rest:
                print_subcommand_help("changelog")
                sys.exit(1)
            cmd_changelog()
    else:
        # Default: full pipeline. But first — is this a typo'd subcommand
        # or flag? "chek" isn't a file; telling the user their "file" is
        # missing actively misdirects. Distinguish:
        #   - starts with "-"            -> unknown option
        #   - exists, or has mesh suffix -> a file (check_file validates)
        #   - otherwise                  -> probably a subcommand typo
        if first.startswith("-"):
            die(
                f"unknown option: {first}",
                "Run 'mesh-to-cad --help' to see the options.",
            )
        if not Path(first).exists() \
                and Path(first).suffix.lower() not in ACCEPTED_EXTENSIONS:
            subs = ("units", "check", "analyze", "deviation", "update", "changelog")
            close = difflib.get_close_matches(first, subs, n=1, cutoff=0.6)
            hint = (f"Did you mean '{close[0]}'?"
                    if close else
                    f"Subcommands are: {', '.join(subs)}.")
            die(
                f"unknown subcommand: {first}",
                f"{hint}\nRun 'mesh-to-cad --help' for usage.",
            )
        # The first arg must be a file; anything else is a usage error
        # with guidance, not a traceback.
        if len(argv) != 1:
            die(
                f"don't know what to do with: {' '.join(argv)}",
                "Usage: mesh-to-cad <file.stl>\n"
                "   Or: mesh-to-cad --help  (see all subcommands)",
            )
        if as_json:
            die("--json doesn't apply to the full pipeline run.",
                "Use it with a subcommand: mesh-to-cad check file.stl --json")
        cmd_full(check_file(first), project_dir=output_dir)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        # Ctrl+C mid-run: don't dump a traceback. The user stopped it on
        # purpose; acknowledge and exit cleanly.
        print("\n\nStopped by user (Ctrl+C). No files were harmed.", file=sys.stderr)
        sys.exit(130)
    except BrokenPipeError:
        # Piped to `head` and it closed early: not an error, just exit.
        sys.exit(0)
